# Everything that runs on Linux keeps LF line endings, also when checked out on Windows
* text=auto eol=lf
*.sh text eol=lf
packaging/AppRun text eol=lf
*.desktop text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.qml text eol=lf

# Windows batch files keep CRLF, as cmd.exe expects
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.ico binary
*.dll binary
*.exe binary
